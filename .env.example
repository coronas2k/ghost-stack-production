# Production: public DNS A/AAAA for DOMAIN must point at this host; publish TCP 80 and 443.
# OrbStack local: caddy.<compose-project-folder>.orb.local — use ./scripts/stack.sh local-up (not up).
DOMAIN=blog.example.com

HTTP_PORT=80
HTTPS_PORT=443

# Let's Encrypt account email (expiry and issuance notices). Caddy issues and renews certs automatically.
ACME_EMAIL=admin@example.com
# Staging while testing: https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Do not change DATABASE_* after the database volume is initialized.
DATABASE_ROOT_PASSWORD=CHANGE_ME
DATABASE_USER=ghost
DATABASE_PASSWORD=CHANGE_ME

UPLOAD_LOCATION=./data/ghost
MYSQL_DATA_LOCATION=./data/mysql

# Transactional mail (logins, invites, password resets). Use Direct only for local smoke tests.
mail__transport=SMTP
mail__options__host=smtp.example.com
mail__options__port=465
mail__options__secure=true
mail__options__auth__user=support@example.com
mail__options__auth__pass=CHANGE_ME
mail__from="'Site Support' <support@example.com>"
